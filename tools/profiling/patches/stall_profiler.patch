+	/**
+		Drops decoded Animate bitmap caches while keeping library structure.
+		Bitmaps are recreated lazily on next use.
+	**/
+	public function clearBitmapCaches(disposeBitmaps:Bool = false):Void
+	{
+		#if (lime && !flash && swf_hardware_bitmap_cache)
+		if (disposeBitmaps)
+		{
+			if (hardwareBitmapData != null)
+			{
+				for (bitmapData in hardwareBitmapData)
+				{
+					if (bitmapData != null)
+					{
+						bitmapData.dispose();
+					}
+				}
+			}
+
+			if (readableShapeBitmapData != null)
+			{
+				for (bitmapData in readableShapeBitmapData)
+				{
+					if (bitmapData != null)
