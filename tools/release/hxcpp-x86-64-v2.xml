<xml>

	<section id="vars">
		<set name="MSVC_ARCH" value="SSE4.2" if="windows HXCPP_M64" />
	</section>

	<section id="exes">
		<compiler id="linux" if="linux HXCPP_M64">
			<flag value="-march=x86-64-v2" />
		</compiler>
		<compiler id="darwin" if="macos HXCPP_M64" unless="HXCPP_ARM64">
			<flag value="-march=x86-64-v2" />
		</compiler>

		<linker id="dll" if="linux HXCPP_M64">
			<flag value="-march=x86-64-v2" />
		</linker>

		<linker id="exe" if="linux HXCPP_M64">
			<flag value="-march=x86-64-v2" />
		</linker>

		<linker id="dll" if="macos HXCPP_M64" unless="HXCPP_ARM64">
			<flag value="-march=x86-64-v2" />
		</linker>

		<linker id="exe" if="macos HXCPP_M64" unless="HXCPP_ARM64">
			<flag value="-march=x86-64-v2" />
		</linker>
	</section>

</xml>
