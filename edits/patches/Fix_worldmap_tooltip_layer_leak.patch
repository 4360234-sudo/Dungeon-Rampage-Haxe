Subject: [PATCH] Clear TooltipLayer on world map deinit (#42)
diff --git a/src/town/MapTownSubState.hx b/src/town/MapTownSubState.hx
index 9d1bb08..08afdc4 100644
--- a/src/town/MapTownSubState.hx
+++ b/src/town/MapTownSubState.hx
@@ -149,6 +149,11 @@ package town
       
       override public function destroy() 
       {
+         if(mWorldMap != null)
+         {
+            mWorldMap.deinit();
+            mWorldMap = null;
+         }
          if(mEventComponent != null)
          {
             mEventComponent.destroy();
diff --git a/src/uI/map/UIMapWorldMap.hx b/src/uI/map/UIMapWorldMap.hx
index 9ae8893..e821b39 100644
--- a/src/uI/map/UIMapWorldMap.hx
+++ b/src/uI/map/UIMapWorldMap.hx
@@ -1058,6 +1058,25 @@ return null;
          {
             tearDownHacksToPlayNode();
          }
+         clearTooltipLayer();
+      }
+      
+      function clearTooltipLayer() 
+      {
+         var tooltipLayer:flash.display.DisplayObjectContainer;
+         if(mDBFacade == null || mDBFacade.sceneGraphManager == null)
+         {
+            return;
+         }
+         tooltipLayer = mDBFacade.sceneGraphManager.getLayer(107);
+         if(tooltipLayer == null)
+         {
+            return;
+         }
+         while(tooltipLayer.numChildren > 0)
+         {
+            tooltipLayer.removeChildAt(0);
+         }
       }
       
       function createPlayerAvatar() 
