@@ -107,6 +110,13 @@
          {
             return;
          }
+         if(FloorEndingGui.DEBUG_ULTIMATE_VICTORY_REPRO_MODE != FloorEndingGui.DEBUG_ULTIMATE_VICTORY_REPRO_MODE_OFF && !mDebugUltimateVictoryReproTriggered && mActiveFloor.isInfiniteDungeon)
+         {
+            mDebugUltimateVictoryReproTriggered = true;
+            Logger.warn("[UltimateVictoryRepro] replacing floorEnding with terminal victory currentFloor=" + Std.string(mActiveFloor.getCurrentFloorNum()) + " countdown=" + Std.string(param1) + " mode=" + Std.string(FloorEndingGui.DEBUG_ULTIMATE_VICTORY_REPRO_MODE));
+            mActiveFloor.debugReproDungeonVictory();
+            return;
+         }
          mActiveFloor.floorEnding(param1);
       }
       
